# Everychat — Phase 1 environment variables
# Copy to .env and edit. .env is git-ignored.

# Local SQLite path inside the container (or host for `make dev`).
EVERYCHAT_DB_PATH=./data/everychat.db

# Public-facing URL used to construct magic-link emails.
EVERYCHAT_BASE_URL=https://everychat.local

# Bind address for the Go HTTP server.
EVERYCHAT_ADDR=:8080

# Phase 5+ — Hetzner provisioning. Leave unset / "0" in Phase 1.
# EVERYCHAT_HETZNER_LIVE=0
# HCLOUD_TOKEN=

# Phase 2+ — LLM providers. Not used in Phase 1.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Phase 5+ — Postmark transactional email. Not used in Phase 1 (stdout sender).
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM=hello@everychat.example

# Phase 5+ — Mollie billing. Not used in Phase 1.
# MOLLIE_API_KEY=
