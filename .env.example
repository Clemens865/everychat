# Everychat — Phase 1 environment variables
# Copy to .env and edit. .env is git-ignored.

# Local SQLite path inside the container (or host for `make dev`).
EVERYCHAT_DB_PATH=./data/everychat.db

# Public-facing URL used to construct magic-link emails.
EVERYCHAT_BASE_URL=https://everychat.local

# Bind address for the Go HTTP server.
EVERYCHAT_ADDR=:8080

# Phase 5+ — Hetzner provisioning. Leave unset / "0" in Phase 1.
# EVERYCHAT_HETZNER_LIVE=0
# HCLOUD_TOKEN=

# Phase 2 — LLM providers (required for `make compose` once Phase 2 ships).
# Anthropic Claude — chat completions (default model: claude-sonnet-4-6).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — embeddings (text-embedding-3-small, 1536-dim).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LiteLLM sidecar URL. Default points at the compose service; override
# only for `make dev` runs without the sidecar.
EVERYCHAT_LITELLM_URL=http://litellm:4000

# Optional Phase 4 alternative — Voyage embeddings (1024-dim, EU-sovereignty pass).
# Uncomment in litellm/config.yaml and run a fresh migration before swapping.
# VOYAGE_API_KEY=

# Phase 5+ — Postmark transactional email. Not used in Phase 1 (stdout sender).
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM=hello@everychat.example

# Phase 5+ — Mollie billing. Not used in Phase 1.
# MOLLIE_API_KEY=
